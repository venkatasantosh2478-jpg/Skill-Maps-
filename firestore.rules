rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'venkatasantosh2478@gmail.com' || 
        request.auth.token.email == 'admin@skillsmap.io' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test doc
    match /test/connection {
      allow read: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profile with isolated private metrics
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && (
        !('role' in incoming()) || incoming().role == 'student' || isAdmin()
      );
      allow update: if (isOwner(userId) && (
        !('role' in incoming()) || incoming().role == existing().role || isAdmin()
      )) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Badges subcollection
      match /badges/{badgeId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(badgeId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Community Messages
    match /community_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().authorId == request.auth.uid || 
        isAdmin() ||
        // Allow adding helpful vote
        incoming().diff(existing()).affectedKeys().hasOnly(['helpfulVotes', 'helpfulVoterIds'])
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
    }
  }
}
