{
  "name": "GuidanceSession",
  "type": "object",
  "properties": {
    "counselor": {
      "type": "string"
    },
    "counselorSpecialty": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "timeSlot": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "counselor",
    "date",
    "timeSlot"
  ]
}